<div class="gap-2 grid grid-cols-2" data-controller="theme">
  <% available_themes.each do |theme| %>
    <div data-theme="<%= theme %>" 
         data-action="click->theme#setSpecificTheme" 
         class="bg-base-100 text-base-content rounded-lg w-full p-3 cursor-pointer hover:bg-base-200/60 transition-colors theme-item-mobile">
      <div class="space-y-2 text-center">
        <div class="flex items-center justify-center gap-2">
          <div class="w-4 h-4 rounded-full bg-primary ring-1 ring-base-content/20"></div>
          <div class="w-4 h-4 rounded-full bg-secondary ring-1 ring-base-content/20"></div>
          <div class="w-4 h-4 rounded-full bg-accent ring-1 ring-base-content/20"></div>
        </div>
        <div class="font-medium text-sm capitalize"><%= theme.tr('-', ' ') %></div>
      </div>
    </div>
  <% end %>
</div>
