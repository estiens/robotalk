<div class="dropdown dropdown-end" data-controller="theme">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle" aria-label="Change theme">
    <label class="swap swap-rotate" data-theme-target="toggle">
      <input type="checkbox" />
      
      <span class="material-symbols-outlined swap-on text-2xl">light_mode</span>
      <span class="material-symbols-outlined swap-off text-2xl">dark_mode</span>
    </label>
  </div>
  
  <ul tabindex="0" class="z-[9999] gap-2 grid grid-cols-2 bg-base-100 shadow-2xl mt-4 p-4 border border-base-300/50 rounded-box w-[36rem] max-h-[90vh] overflow-y-auto dropdown-content" style="z-index: 99999 !important;">
    <li class="col-span-full px-2 py-1 menu-title">
      <span class="font-semibold text-base-content/80">Select Theme</span>
    </li>
    <% available_themes.each do |theme| %>
      <li class="col-span-1">
        <div data-theme="<%= theme %>" 
             data-action="click->theme#setSpecificTheme" 
             class="bg-base-100 hover:bg-base-200/60 p-3 rounded-lg w-full text-base-content transition-colors cursor-pointer theme-item">
          <div class="flex justify-between items-center">
            <span class="font-semibold capitalize"><%= theme.tr('-', ' ') %></span>
            <div class="flex items-center gap-2 -space-x-1">
              <div class="bg-primary rounded-full ring-1 ring-base-content/20 w-5 h-5"></div>
              <div class="bg-secondary rounded-full ring-1 ring-base-content/20 w-5 h-5"></div>
              <div class="bg-accent rounded-full ring-1 ring-base-content/20 w-5 h-5"></div>
              <div class="bg-neutral rounded-full ring-1 ring-base-content/20 w-5 h-5"></div>
            </div>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
