<div class="min-h-screen bg-base-100">
  <div class="container mx-auto px-4 py-8">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-base-content mb-4">Conversation UX Wireframes</h1>
      <p class="text-lg text-base-content/70">Exploring different approaches for multi-participant AI conversations</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Traditional 2-Participant -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-primary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            Two Participants
          </h2>
          <p class="text-base-content/70">Traditional chat layout optimized for two-way conversations</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", two_participants_wireframes_path, class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Multi-Participant -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-secondary">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            Multi-Participant (3-5)
          </h2>
          <p class="text-base-content/70">Organized layout for small group conversations with clear speaker identification</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", multi_participants_wireframes_path, class: "btn btn-secondary btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Many Participants -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-accent">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            Many Participants (6+)
          </h2>
          <p class="text-base-content/70">Grid/radial layout for large group conversations with spatial organization</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", many_participants_wireframes_path, class: "btn btn-accent btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Timeline View -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-info">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Timeline View
          </h2>
          <p class="text-base-content/70">Chronological timeline with enhanced round visualization</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", timeline_view_wireframes_path, class: "btn btn-info btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Speaker Lanes -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-success">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
            </svg>
            Speaker Lanes
          </h2>
          <p class="text-base-content/70">Horizontal lanes per participant, like a music sequencer for conversations</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", speaker_lanes_wireframes_path, class: "btn btn-success btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Threaded View -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-warning">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            Threaded View
          </h2>
          <p class="text-base-content/70">Tree-like structure showing conversation branches and responses</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", threaded_view_wireframes_path, class: "btn btn-warning btn-sm" %>
          </div>
        </div>
      </div>

      <!-- Compact Cards -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
        <div class="card-body">
          <h2 class="card-title text-error">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            Compact Cards
          </h2>
          <p class="text-base-content/70">Dense card-based layout for information-heavy conversations</p>
          <div class="card-actions justify-end">
            <%= link_to "View Design", compact_cards_wireframes_path, class: "btn btn-error btn-sm" %>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center">
      <div class="divider"></div>
      <p class="text-base-content/60">These wireframes explore different UX approaches for multi-participant AI conversations using DaisyUI components</p>
      <%= link_to "← Back to Conversations", root_path, class: "btn btn-ghost mt-4" %>
    </div>
  </div>
</div>