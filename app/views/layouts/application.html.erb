<!DOCTYPE html>
<html data-theme="light" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "RoboConvo - AI Conversations" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# DaisyUI CDN for components %>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet" type="text/css" />
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-300 min-h-screen">
    <!-- Modern Navigation Header -->
    <header class="top-0 z-50 sticky bg-neutral shadow-xl border-b border-base-300/50 text-neutral-content">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 container">
        <div class="flex justify-between items-center h-28">
          
          <!-- Logo/Brand -->
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center space-x-3 text-xl font-bold text-neutral-content hover:text-primary transition-colors" do %>
              <span class="text-2xl">🤖</span>
              <span class="hidden sm:block">RoboConvo</span>
            <% end %>
          </div>

          <!-- Center Navigation (Desktop) -->
          <nav class="hidden md:flex items-center">
            <%= link_to conversations_path, class: "px-3 py-1.5 text-sm font-medium text-neutral-content transition-colors hover:text-primary" do %>
              Conversations
            <% end %>
          </nav>

          <!-- Right Side -->
          <div class="flex items-center space-x-4">
            
            <!-- New Chat Button -->
            <%= link_to "New Chat", new_conversation_path, class: "btn btn-primary btn-sm hidden md:inline-flex" %>

            <!-- Theme Switcher (Desktop) -->
            <div class="hidden sm:block">
              <%= render 'shared/theme_switcher' %>
            </div>

            <!-- User Menu or Auth -->
            <% if logged_in? %>
              <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-ghost btn-circle avatar">
                  <div class="flex justify-center items-center bg-gradient-to-br from-primary to-secondary rounded-full w-10 h-10 font-semibold text-primary-content">
                    <%= current_user.email[0].upcase %>
                  </div>
                </label>
                <ul tabindex="0" class="z-[101] bg-base-100 shadow-xl mt-4 p-2 border border-base-300/50 rounded-box w-52 text-base-content dropdown-content menu">
                  <li class="menu-title">
                    <span class="text-xs text-base-content/60"><%= current_user.email %></span>
                  </li>
                  <li><%= link_to models_path do %>Models<% end %></li>
                  <li><hr class="my-1"></li>
                  <li><%= link_to logout_path, method: :delete, data: { turbo_method: :delete } do %>
                    <span class="text-error">Sign Out</span>
                  <% end %></li>
                </ul>
              </div>
            <% else %>
              <div class="hidden sm:flex items-center space-x-2">
                <%= link_to "Sign In", login_path, class: "btn btn-ghost" %>
                <%= link_to "Sign Up", signup_path, class: "btn btn-primary" %>
              </div>
            <% end %>

            <!-- Mobile Menu Button -->
            <div class="md:hidden">
              <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-ghost btn-circle">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                </label>
                <ul tabindex="0" class="z-[101] bg-base-100 shadow-xl mt-4 p-2 border border-base-300/50 rounded-box w-52 text-base-content dropdown-content menu">
                  <li><%= link_to "Conversations", conversations_path %></li>
                  <li><%= link_to "New Chat", new_conversation_path %></li>
                  <li><hr class="my-1"></li>
                  <li>
                    <details>
                      <summary>Theme</summary>
                      <ul class="p-2">
                        <li><%= render 'shared/theme_switcher_mobile' %></li>
                      </ul>
                    </details>
                  </li>
                  <% unless logged_in? %>
                    <li><hr class="my-1"></li>
                    <li><%= link_to "Sign In", login_path %></li>
                    <li><%= link_to "Sign Up", signup_path %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 py-12 container">
        <%= yield %>
      </div>
    </main>

    <!-- Clean Footer -->
    <footer class="bg-base-200 mt-auto border-t border-base-300/50">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 py-8 container">
        <div class="text-center">
          <div class="flex justify-center items-center space-x-2 mb-4 text-sm text-base-content/60">
            <span>Powered by</span>
            <div class="badge-outline badge badge-sm">OpenRouter</div>
            <span>•</span>
            <div class="badge-outline badge badge-sm">Rails 8</div>
          </div>
          <p class="text-xs text-base-content/40">
            © <%= Date.current.year %> RoboConvo - AI Conversation Platform
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
