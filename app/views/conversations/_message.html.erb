<%= turbo_frame_tag message do %>
  <% participant = message.conversation_participant || message.conversation.participant_for_model(local_assigns.fetch(:message_model_id, message.model_id)) %>
  <% is_first_participant = participant&.turn_order == 1 %>
  <% avatar_model_id = participant&.model_id || local_assigns.fetch(:message_model_id, message.model_id) %>
  <% display_round_number = message.round_number || "?" %>
    
  <div class="chat <%= is_first_participant ? 'chat-start' : 'chat-end' %> group/message animate-fade-in-up <%= participant_class(participant) if participant %>" style="animation-delay: <%= local_assigns.fetch(:index, 0) * 0.1 %>s;">
      <!-- Avatar -->
      <div class="chat-image avatar">
        <div class="w-12 h-12 rounded-full bg-<%= is_first_participant ? 'primary' : 'secondary' %> flex items-center justify-center text-lg text-primary-content shadow-md transform group-hover/message:scale-110 transition-transform duration-300">
          <%= model_avatar_emoji(avatar_model_id) %>
        </div>
      </div>
      
      <!-- Chat Header -->
      <div class="chat-header mb-1.5">
        <div class="flex items-center gap-2.5 <%= is_first_participant ? 'justify-start' : 'justify-end' %>">
          <span class="font-semibold text-base-content">
            <%= participant&.name || "Unknown" %>
          </span>
          <div class="flex items-center gap-1.5 text-xs text-base-content/60">
            <span class="badge badge-xs badge-outline">R<%= display_round_number %></span>
            <time><%= message.created_at.strftime("%I:%M %p") %></time>
          </div>
        </div>
      </div>
      
      <!-- Chat Bubble -->
      <div class="relative">
        <div class="chat-bubble <%= is_first_participant ? 'chat-bubble-primary' : 'chat-bubble-secondary' %> text-base max-w-3xl shadow-lg border-0 relative overflow-hidden group-hover/message:shadow-xl transition-shadow duration-300">
          
          <div class="relative z-10" id="<%= dom_id(message, "content") %>">
            <% if message.content.present? %>
              <% content_lines = message.content.lines.count %>
              <% should_truncate = content_lines > 10 || message.content.length > 800 %>
              
              <% if should_truncate %>
                <div data-controller="expandable-message">
                  <div data-expandable-message-target="preview">
                    <%= simple_format(truncate(message.content, length: 800, separator: '. '), class: "leading-relaxed text-base-content/90") %>
                  </div>
                  <div data-expandable-message-target="full" class="hidden">
                    <%= simple_format(message.content, class: "leading-relaxed text-base-content/90") %>
                  </div>
                  <div class="mt-3 text-center">
                    <button class="btn btn-xs btn-ghost gap-1" 
                            data-action="click->expandable-message#toggle"
                            data-expandable-message-target="toggleButton">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                      </svg>
                      Show more
                    </button>
                  </div>
                </div>
              <% else %>
                <%= simple_format(message.content, class: "leading-relaxed text-base-content/90") %>
              <% end %>
            <% else %>
              <div class="flex items-center gap-3 py-2">
                <div class="flex gap-1">
                  <div class="w-2 h-2 bg-current rounded-full animate-bounce" style="animation-delay: 0s;"></div>
                  <div class="w-2 h-2 bg-current rounded-full animate-bounce" style="animation-delay: 0.1s;"></div>
                  <div class="w-2 h-2 bg-current rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
                </div>
                <span class="text-sm opacity-70 animate-pulse">Thinking...</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Enhanced Footer with More Details -->
      <div class="chat-footer opacity-60 group-hover/message:opacity-80 transition-opacity">
        <div class="flex items-center gap-2 text-xs mt-1 <%= is_first_participant ? '' : 'justify-end' %>">
          <% if message.metadata&.dig('response_time_ms') %>
            <div class="badge badge-xs badge-outline gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><%= message.metadata['response_time_ms'].to_i %>ms</span>
            </div>
          <% end %>
          <% if message.metadata&.dig('total_tokens') %>
            <div class="badge badge-xs badge-outline gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3 h-3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
              </svg>
              <span><%= message.metadata['total_tokens'] %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
<% end %>
