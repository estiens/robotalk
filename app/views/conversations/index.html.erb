
<!-- Stats Section -->
<div class="mb-12">
  <div class="bg-neutral shadow-lg w-full text-neutral-content stats stats-vertical lg:stats-horizontal">
      <div class="place-items-center stat">
        <div class="text-primary stat-figure">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div class="text-neutral-content/70 stat-title">Total Conversations</div>
        <div class="text-primary stat-value"><%= @conversations.count %></div>
        <div class="text-neutral-content/70 stat-desc">All time</div>
      </div>
      
      <div class="place-items-center stat">
        <div class="text-secondary stat-figure">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </div>
        <div class="text-neutral-content/70 stat-title">Currently Active</div>
        <div class="text-secondary stat-value"><%= @conversations.generating.count + @conversations.interactive.count %></div>
        <div class="text-neutral-content/70 stat-desc">In progress</div>
      </div>
      
      <div class="place-items-center stat">
        <div class="text-accent stat-figure">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-neutral-content/70 stat-title">Completed</div>
        <div class="text-accent stat-value"><%= @conversations.complete.count %></div>
        <div class="text-neutral-content/70 stat-desc">Finished</div>
      </div>
    </div>
</div>

<!-- Content Area -->
<%= turbo_stream_from "conversations" %> <%# Add stream subscription for the index page %>
<% if @conversations.any? %>
    <!-- Section Header -->
    <div class="flex lg:flex-row flex-col justify-between items-start lg:items-center gap-6 mb-12">
      <div>
        <h1 class="bg-clip-text bg-gradient-to-r from-primary to-secondary mb-2 font-bold text-transparent text-3xl lg:text-4xl">Conversations</h1>
        <p class="text-base-content/70 text-lg">Manage and explore your AI dialogues</p>
      </div>
      
      <!-- Filter/Sort Controls -->
      <div class="flex items-center gap-4">
        <div class="dropdown dropdown-end">
          <div tabindex="0" role="button" class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M16.5 16.5L20.25 12.75" />
            </svg>
            Sort
          </div>
          <ul tabindex="0" class="z-10 bg-base-100 shadow-lg p-2 rounded-box w-56 dropdown-content menu">
            <li><a>Newest First</a></li>
            <li><a>Oldest First</a></li>
            <li><a>Most Active</a></li>
            <li><a>Recently Updated</a></li>
          </ul>
        </div>
        
        <div class="badge badge-primary badge-lg">
          <%= pluralize(@conversations.count, 'conversation') %>
        </div>
      </div>
    </div>

    <!-- Conversations Grid -->
    <div id="conversations" class="gap-8 grid md:grid-cols-2 xl:grid-cols-3"> <%# Add id for broadcast target %>
      <% @conversations.each_with_index do |conversation, index| %>
        <%= render 'conversation_card', conversation: conversation, index: index %>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="min-h-[60vh] hero">
      <div class="text-center hero-content">
        <div class="max-w-lg">
          <div class="mb-8 text-8xl animate-bounce">💬</div>
          <h2 class="mb-6 font-bold text-4xl">No conversations yet</h2>
          <p class="mb-10 text-base-content/80 text-xl leading-relaxed">
            Create your first conversation between AI models and watch them discuss, debate, and collaborate on topics you choose.
          </p>
          
          <%= link_to new_conversation_path, class: "btn btn-primary btn-lg gap-3 mb-6" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Create Your First Conversation
          <% end %>
          
          <div class="text-base-content/60">
            or explore <%= link_to "available AI models", models_path, class: "link link-primary font-semibold" %> first
          </div>
        </div>
      </div>
    </div>
  <% end %>
