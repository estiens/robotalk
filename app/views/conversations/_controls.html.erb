<!-- Controls Section -->
<div class="bg-base-100 shadow-xl border border-base-300/50 card" data-controller="streaming-conversation"
     data-streaming-conversation-conversation-id-value="<%= conversation.id %>"
     data-streaming-conversation-next-model-value="<%= conversation.can_continue? ? conversation.next_speaker : '' %>">
  <div class="card-body">
    <% if conversation.messages.empty? %>
      <!-- Start Button -->
      <div id="start-conversation-controls" class="py-8 text-center">
        <h3 class="mb-4 font-semibold text-xl text-primary">Ready to begin?</h3>
        <p class="mb-6 text-base-content/70">Start the conversation between your AI models</p>
        <%= button_to start_conversation_path(conversation),
            method: :post,
            class: "btn btn-success btn-md gap-2",
            data: {
              turbo_frame: "conversation",
              streaming_conversation_target: "startButton",
              controller: "conversation-controls",
              action: "click->conversation-controls#showLoading",
              test: "start-conversation-button"
            } do %>
          <span class="material-symbols-outlined">play_arrow</span>
          Start Conversation
        <% end %>
      </div>
      
    <% elsif conversation.can_continue? %>
      <!-- Manual Continue Mode -->
      <div class="py-6 text-center">
        <h3 class="mb-2 font-semibold text-lg">Ready for Next Round</h3>
        <p class="text-base-content/70 mb-4">Click "Next Round" to continue the conversation</p>
      </div>
    <% else %>
      <!-- Conversation Complete -->
      <div class="py-8 text-center">
        <div class="mb-4 text-5xl">✅</div>
        <h3 class="mb-2 font-semibold text-xl text-success" data-test="conversation-complete-message">Conversation Complete</h3>
        <p class="text-base-content/70">All <%= conversation.max_rounds %> rounds have been completed</p>
      </div>
    <% end %>
  </div>
</div>
