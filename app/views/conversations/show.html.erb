<%= turbo_stream_from @conversation, "messages" %>
<%= turbo_frame_tag "conversation" do %>
<div data-controller="conversation-updater">
  
  <!-- Header -->
  <div class="bg-base-100 border-b border-base-200">
    <div class="container mx-auto px-4">
      <div class="navbar min-h-16">
        <div class="navbar-start">
          <%= link_to conversations_path, class: "btn btn-ghost" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back
          <% end %>
        </div>
        
        <div class="navbar-center">
          <div class="flex items-center gap-3">
            <% @conversation.participants.ordered.each_with_index do |p, i| %>
              <div class="avatar">
                <div class="w-8 h-8 rounded-full bg-<%= i == 0 ? 'primary' : 'secondary' %>">
                  <div class="flex items-center justify-center w-full h-full text-primary-content text-sm">
                    <%= model_avatar_emoji(p.model_id) %>
                  </div>
                </div>
              </div>
              <% if i < @conversation.participants.count - 1 %>
                <span class="text-base-content/40 mx-1">vs</span>
              <% end %>
            <% end %>
            <div class="ml-3">
              <div class="font-semibold">
                <% @conversation.participants.ordered.each_with_index do |p, i| %>
                  <%= p.name || "Participant #{i + 1}" %><%= " vs " if i < @conversation.participants.count - 1 %>
                <% end %>
              </div>
              <% if @conversation.conversation_topic.present? %>
                <div class="text-xs text-base-content/60" data-test="conversation-topic">
                  <%= truncate(@conversation.conversation_topic, length: 50) %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <div class="navbar-end">
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
              </svg>
            </div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-48">
              <li>
                <%= link_to edit_conversation_path(@conversation) do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                  </svg>
                  Edit
                <% end %>
              </li>
              <li>
                <%= button_to restart_conversation_path(@conversation),
                    method: :post,
                    class: "text-warning",
                    data: { confirm: "Restart conversation? All messages will be deleted." } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                  </svg>
                  Restart
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Controls Section -->
  <% if @conversation.messages.any? %>
    <!-- Progress & Controls Bar -->
    <div class="bg-base-50 border-b border-base-200">
      <div class="container mx-auto px-4 py-3">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-4">
            <div id="round-indicator">
              <%= render "conversations/round_indicator", conversation: @conversation %>
            </div>
            <% if @conversation.next_speaker %>
              <div class="flex items-center gap-2 text-sm">
                <span class="text-base-content/60">Next:</span>
                <div class="avatar">
                  <div class="w-6 h-6 rounded-full bg-<%= @conversation.next_speaker.turn_order == 1 ? 'primary' : 'secondary' %>">
                    <div class="flex items-center justify-center w-full h-full text-primary-content text-xs">
                      <%= model_avatar_emoji(@conversation.next_speaker.model_id) %>
                    </div>
                  </div>
                </div>
                <span class="font-medium"><%= @conversation.next_speaker.name %></span>
              </div>
            <% end %>
          </div>
          
          <div class="flex items-center gap-3">
            <% if @conversation.can_continue? %>
              <div class="form-control">
                <label class="label cursor-pointer gap-2 py-2">
                  <span class="label-text text-sm">Auto</span>
                  <input type="checkbox"
                         class="toggle toggle-primary toggle-sm"
                         data-controller="auto-continue"
                         data-action="change->auto-continue#toggle"
                         data-auto-continue-conversation-id-value="<%= @conversation.id %>"
                         data-auto-continue-max-rounds-value="<%= @conversation.max_rounds %>"
                         data-auto-continue-active-value="false"
                         data-test="auto-continue-toggle" />
                </label>
              </div>
              
              <%= button_to continue_conversation_path(@conversation), 
                  method: :post,
                  class: "btn btn-primary gap-2",
                  data: { 
                    turbo_frame: "conversation",
                    streaming_conversation_target: "continueButton",
                    controller: "conversation-controls",
                    action: "click->conversation-controls#showLoading",
                    test: "continue-conversation-button"
                  } do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                </svg>
                Continue
              <% end %>
            <% else %>
              <div class="badge badge-success gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                Complete
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Start Controls for new conversations -->
    <div class="container mx-auto px-4 py-6">
      <div id="conversation-controls-container">
        <%= render "conversations/controls", conversation: @conversation %>
      </div>
    </div>
  <% end %>

  <!-- Error Alert -->
  <% if conversation_has_content_issues?(@conversation) %>
    <div class="container mx-auto px-4 pt-4">
      <div class="alert alert-warning">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current w-6 h-6 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
        </svg>
        <div>
          <div class="font-bold">Content Issues Detected</div>
          <div class="text-sm">
            <%= content_missing_count(@conversation) %> message(s) have missing content. 
            <%= link_to "Debug", debug_conversation_path(@conversation), class: "link link-hover", target: "_blank" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Messages -->
  <div class="container mx-auto px-4 py-6">
    <div id="conversation-messages" data-streaming-conversation-target="messagesContainer">
      <%= render partial: "conversations/messages", locals: { conversation: @conversation } %>
    </div>
  </div>
  
</div>
<% end %>
