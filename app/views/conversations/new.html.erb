<div class="mx-auto max-w-5xl">
    <!-- Header -->
    <div class="mb-12 text-center">
      <h1 class="bg-clip-text bg-gradient-to-r from-primary to-secondary mb-3 font-bold text-transparent text-5xl font-lexend" data-test="page-title">
        Create a New Conversation
      </h1>
      <p class="text-base-content/70 text-lg">Configure a dialogue between multiple AI participants.</p>
    </div>

    <%= form_with model: @conversation, local: true, class: "space-y-8" do |form| %>
      <!-- Error Messages -->
      <% if @conversation.errors.any? %>
        <div class="shadow-lg alert alert-error">
          <span class="material-symbols-outlined text-2xl">error</span>
          <div>
            <h3 class="font-bold">Please fix the following errors:</h3>
            <ul class="mt-2 text-sm list-disc list-inside">
              <% @conversation.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <!-- Dialogue Instructions Section -->
      <div class="bg-neutral text-neutral-content shadow-xl border border-primary/20 rounded-2xl card"
           data-controller="dialogue-form"
           data-dialogue-form-types-value="<%= ConversationTemplates::DIALOGUE_TYPES.to_json %>">
        <div class="card-body">
            <h2 class="flex items-center gap-3 mb-4 font-bold text-neutral-content text-xl card-title">
              <span class="material-symbols-outlined">notes</span>
              Dialogue Instructions
            </h2>
            <div class="form-control">
              <textarea data-dialogue-form-target="dialogueInstructionsTextarea"
                        data-action="input->dialogue-form#syncHiddenField"
                        class="bg-transparent focus:bg-base-100/50 textarea-bordered w-full h-32 text-base-content transition-colors textarea"
                        placeholder="Enter custom dialogue instructions..."></textarea>
              <label class="label">
                <span class="label-text-alt text-base-content/60">Define how the conversation should be structured and conducted.</span>
              </label>
            </div>
            
            <div class="mt-4 form-control">
              <label class="label">
                <span class="font-semibold text-neutral-content label-text">Or choose a template:</span>
              </label>
              <select data-dialogue-form-target="dialogueType"
                      data-action="change->dialogue-form#updateInstructions"
                      class="bg-transparent w-full text-base-content select-bordered select"
                      data-test="dialogue-type">
                <option value="custom" selected>Custom Instructions</option>
                <% dialogue_types_for_select.each do |category, types| %>
                  <optgroup label="<%= category %>">
                    <% types.each do |name, key| %>
                      <option value="<%= key %>"><%= name %></option>
                    <% end %>
                  </optgroup>
                <% end %>
              </select>
            </div>
            
            <div class="flex justify-between items-start gap-6 mt-6">
              <!-- Topic -->
              <div class="w-full form-control">
                <%= form.label :conversation_topic, class: "label" do %>
                  <span class="font-semibold text-neutral-content label-text">Topic</span>
                <% end %>
                <%= form.text_field :conversation_topic, 
                    class: "input input-bordered w-full bg-transparent text-base-content",
                    placeholder: "e.g., artificial intelligence, climate change...",
                    data: { test: "conversation-topic" } %>
                <label class="label">
                  <span class="label-text-alt text-base-content/60">The specific subject for discussion</span>
                </label>
              </div>

              <!-- Max Rounds -->
              <div class="w-48 text-center form-control">
                <%= form.label :max_rounds, class: "label" do %>
                  <span class="font-semibold text-neutral-content label-text">Rounds</span>
                <% end %>
                <%= form.number_field :max_rounds, 
                    min: 1, max: 50, value: 10,
                    class: "input input-bordered w-full bg-transparent text-base-content text-center",
                    data: { test: "max-rounds" } %>
                <label class="label">
                  <span class="label-text-alt text-base-content/60">1-50</span>
                </label>
              </div>
            </div>
        </div>
      </div>

      <!-- Hidden field for dialogue instructions -->
      <%= form.hidden_field :dialogue_instructions, "data-dialogue-form-target": "dialogueInstructionsField" %>

      <!-- Participants Section -->
      <div class="bg-base-100 shadow-xl border border-secondary/20 rounded-2xl card" 
           data-controller="participant-form"
           data-participant-form-participant-index-value="<%= @conversation.participants.size %>"
           data-participant-form-model-options-value="<%= @available_models.to_json %>"
           data-participant-form-characters-value="<%= ConversationTemplates::CHARACTER_ARCHETYPES.to_json %>"
           >
        <div class="card-body">
            <div class="flex justify-between items-center mb-6">
              <div>
                <h2 class="flex items-center gap-3 font-bold text-primary text-xl card-title">
                  <span class="material-symbols-outlined">groups</span>
                  AI Participants
                </h2>
                <p class="mt-1 text-sm text-base-content/60">Configure the AI models that will participate in your conversation</p>
              </div>
              <button type="button" 
                      class="gap-2 shadow-lg hover:shadow-xl hover:scale-105 transition-all btn btn-success transform"
                      data-action="click->participant-form#addParticipant"
                      data-participant-form-target="addButton">
                <span class="material-symbols-outlined">add</span>
                Add Participant
              </button>
            </div>
            
            <div data-participant-form-target="container" class="gap-6 grid md:grid-cols-2">
              <%= form.fields_for :participants do |participant_form| %>
                <%= render 'participant_form', participant_form: participant_form, available_models: @available_models %>
              <% end %>
            </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div class="card-actions justify-end gap-3">
        <%= link_to "Cancel", conversations_path, class: "btn btn-ghost" %>
        <%= form.submit "Generate in Background", name: "generate_in_background", class: "btn btn-secondary", data: { "turbo-submits-with": "Enqueuing..." } %>
        <%= form.submit "Create & View", class: "btn btn-primary", data: { "turbo-submits-with": "Creating...", test: "create-conversation" } %>
      </div>
    <% end %>
</div>

