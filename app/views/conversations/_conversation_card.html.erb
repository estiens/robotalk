<%
  # Alternate card colors for better visual separation
  is_even = local_assigns.fetch(:index, 0).even?
  color_class = is_even ? 'primary' : 'secondary'
  content_class = "#{color_class}-content"
  focus_class = "#{color_class}-focus"
%>
<div class="group relative" data-test="conversation-card-<%= conversation.id %>">
  <!-- Gradient Border Effect -->
  <div class="absolute -inset-0.5 bg-gradient-to-r from-primary via-secondary to-accent opacity-20 group-hover:opacity-40 rounded-2xl transition-all duration-300 blur"></div>
  
  <!-- Delete Button -->
  <div class="top-2 right-2 z-10 absolute opacity-0 group-hover:opacity-100 transition-opacity duration-200">
    <%= button_to conversation_path(conversation), 
        method: :delete,
        remote: true,
        class: "btn btn-circle btn-sm btn-error hover:btn-error shadow-lg",
        data: { 
          confirm: "Are you sure you want to delete this conversation? This action cannot be undone.",
          test: "delete-conversation-button",
          controller: "loading-button",
          action: "click->loading-button#showLoading"
        } do %>
      <i class="text-lg ph ph-x" data-loading-button-target="icon"></i>
      <span class="hidden loading loading-spinner loading-sm" data-loading-button-target="spinner"></span>
    <% end %>
  </div>
  
  <div class="relative bg-base-100 shadow-lg hover:shadow-2xl border border-base-300 rounded-xl overflow-hidden transition-all duration-300">
    <!-- Status Indicator Bar -->
    <div class="h-2 w-full <%= conversation.in_progress? ? 'bg-gradient-to-r from-info via-warning to-info animate-pulse' : conversation.can_continue? ? 'bg-gradient-to-r from-success to-primary' : conversation.failed? ? 'bg-error' : 'bg-neutral' %>"></div>
    
    <!-- Header Section -->
    <div class="bg-<%= color_class %> text-<%= content_class %> p-4">
      <div class="flex justify-between items-start pr-8">
        <% case conversation.status&.to_sym %>
        <% when :in_progress %>
          <div class="flex items-center gap-2 text-warning">
            <div class="bg-warning rounded-full w-2 h-2 animate-ping"></div>
            <span class="font-semibold text-sm">In Progress...</span>
          </div>
        <% when :failed %>
          <div class="flex items-center gap-2 text-error">
            <i class="text-lg ph ph-warning"></i>
            <span class="font-semibold text-sm">Failed</span>
          </div>
        <% else %>
          <div class="flex items-center gap-2">
            <% if conversation.messages.empty? && conversation.pending? %>
              <div class="bg-warning rounded-full w-2 h-2 animate-pulse"></div>
              <span class="font-semibold text-sm">Ready to Start</span>
            <% elsif conversation.can_continue? %>
              <div class="bg-success rounded-full w-2 h-2 animate-pulse"></div>
              <span class="font-semibold text-sm">Round <%= conversation.current_round %>/<%= conversation.max_rounds %></span>
            <% else %>
              <div class="bg-neutral rounded-full w-2 h-2"></div>
              <span class="font-semibold text-sm">Complete</span>
            <% end %>
          </div>
        <% end %>
        <div class="text-xs text-<%= content_class %>/80 bg-<%= content_class %>/10 px-3 py-1 rounded-full border border-<%= content_class %>/20">
          <%= conversation.created_at.strftime("%b %d, %Y") %>
        </div>
      </div>
    </div>

    <div class="space-y-4 p-5">
      <!-- AI Participants Section -->
      <div class="bg-base-200/50 p-4 border border-base-300/50 rounded-lg">
        <div class="flex justify-center items-center gap-3 mb-3">
          <% conversation.participants.ordered.each_with_index do |p, i| %>
            <div class="group/avatar relative">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br <%= i == 0 ? 'from-primary to-primary/70' : 'from-secondary to-secondary/70' %> flex items-center justify-center text-white text-sm shadow-md transform group-hover:scale-110 transition-all duration-200">
                <%= model_avatar_emoji(p.model_id) %>
              </div>
              <!-- Pulse ring for active conversations -->
              <% if conversation.can_continue? && !conversation.in_progress? %>
                <div class="absolute inset-0 rounded-full bg-<%= i == 0 ? 'primary' : 'secondary' %> animate-ping opacity-20"></div>
              <% end %>
            </div>
            <% if i < conversation.participants.count - 1 %>
              <div class="flex items-center">
                <i class="ph-arrows-left-right text-base-content/40 text-lg ph"></i>
              </div>
            <% end %>
          <% end %>
        </div>
        
        <!-- Model Names and Participant Names -->
        <div class="space-y-1 text-center">
          <div>
            <% conversation.participants.ordered.each_with_index do |p, i| %>
              <span class="font-medium text-sm text-base-content">
                <%= p.name || friendly_model_name(p.model_id) %>
              </span>
              <% if i < conversation.participants.count - 1 %>
                <span class="mx-2 font-semibold text-base-content/60">vs</span>
              <% end %>
            <% end %>
          </div>
          <div class="text-xs text-base-content/60">
            <% conversation.participants.ordered.each_with_index do |p, i| %>
              <span class="bg-base-300 px-2 py-1 rounded font-mono">
                <%= p.model_id %>
              </span>
              <% if i < conversation.participants.count - 1 %>
                <span class="mx-2">•</span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      
      <!-- Topic Section -->
      <% if conversation.conversation_topic.present? %>
        <div class="bg-gradient-to-r from-accent/10 to-accent/5 p-4 border-accent border-l-4 rounded-lg">
          <div class="flex items-center gap-2 mb-2">
            <i class="text-accent text-lg ph ph-chat-centered-text"></i>
            <div class="font-bold text-accent text-xs uppercase tracking-wider">Topic</div>
          </div>
          <p class="text-sm text-base-content/80 leading-relaxed"><%= conversation.conversation_topic %></p>
        </div>
      <% end %>
      
      <!-- Latest Message Section -->
      <% if conversation.messages.any? %>
        <% last_message = conversation.messages.last %>
        <div class="bg-gradient-to-r from-info/10 to-info/5 p-4 border-info border-l-4 rounded-lg">
          <div class="flex items-center gap-2 mb-2">
            <i class="text-info text-lg ph ph-chat-circle"></i>
            <div class="font-bold text-info text-xs uppercase tracking-wider">Latest from <%= last_message.conversation_participant&.name || 'AI' %></div>
          </div>
          <p class="text-sm text-base-content/70 line-clamp-2 leading-relaxed">
            <%= truncate(last_message.content, length: 120) %>
          </p>
        </div>
      <% end %>
    </div>
      
    <!-- Actions Section -->
    <div class="bg-base-50 p-4 border-t border-base-300/50">
      <div class="flex justify-between items-center gap-3">
        <div class="flex gap-2">
          <%= link_to conversation_path(conversation), class: "btn btn-ghost btn-sm gap-2 group/view" do %>
            <i class="text-lg group-hover/view:scale-110 transition-transform ph ph-eye"></i>
            View
          <% end %>
          
          <%= link_to edit_conversation_path(conversation), class: "btn btn-outline btn-sm gap-2 group/edit" do %>
            <i class="text-lg group-hover/edit:scale-110 transition-transform ph ph-pencil"></i>
            Edit
          <% end %>
        </div>

        <% if conversation.can_start? %>
          <%= button_to start_conversation_path(conversation),
              method: :post,
              class: "btn btn-primary btn-sm gap-2 shadow-lg hover:shadow-xl transform hover:scale-105 transition-all",
              data: { test: "start-conversation-button" } do %>
            <i class="ph ph-play"></i>
            Start
          <% end %>
        <% elsif conversation.can_continue? %>
          <%= button_to continue_conversation_path(conversation),
              method: :post,
              class: "btn btn-success btn-sm gap-2 shadow-lg hover:shadow-xl transform hover:scale-105 transition-all",
              data: { test: "continue-conversation-button" } do %>
            <i class="ph ph-skip-forward"></i>
            Continue
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
