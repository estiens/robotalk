<div data-controller="conversation-updater" class="mx-auto max-w-4xl">
  
  <!-- Enhanced Conversation Header -->
  <div class="bg-base-100 shadow-2xl mb-8 border-2 border-base-300 rounded-3xl overflow-hidden">
    <!-- Header Accent Bar -->
    <div class="bg-gradient-to-r from-primary via-secondary to-accent h-2"></div>
    
    <div class="p-6 sm:p-8">
      <!-- Breadcrumb with enhanced styling -->
      <div class="flex items-center mb-6 text-sm text-base-content/70">
        <%= link_to conversations_path, class: "hover:text-primary transition-colors font-medium" do %>
          <i class="mr-1 text-lg ph ph-chats-circle"></i>
          Conversations
        <% end %>
        <i class="mx-2 text-base-content/30 text-lg ph-caret-right ph"></i>
        <span class="font-bold text-base-content">AI Dialogue</span>
      </div>

      <!-- Participants & Topic -->
      <div class="flex lg:flex-row flex-col justify-between lg:items-center gap-6">
        <div class="flex-1">
          <!-- Enhanced Participants Display -->
          <div class="flex items-center space-x-4 mb-4">
            <% conversation.participants.ordered.each_with_index do |p, i| %>
              <div class="flex items-center space-x-3 bg-base-200 rounded-2xl px-4 py-3 shadow-lg border-2 <%= i == 0 ? 'border-primary/30' : 'border-secondary/30' %> transform hover:scale-105 transition-all duration-300">
                <div class="w-12 h-12 rounded-xl <%= i == 0 ? 'bg-primary' : 'bg-secondary' %> flex items-center justify-center text-primary-content text-xl shadow-lg">
                  <%= model_avatar_emoji(p.model_id) %>
                </div>
                <div>
                  <div class="font-bold text-base-content text-lg"><%= p.name || "AI #{i + 1}" %></div>
                  <div class="font-medium text-xs text-base-content/70"><%= friendly_model_name(p.model_id) %></div>
                </div>
              </div>
              <% if i < conversation.participants.count - 1 %>
                <div class="hidden sm:flex items-center">
                  <div class="flex justify-center items-center bg-accent shadow-lg rounded-full w-10 h-10 sm:w-8 sm:h-8 text-accent-content">
                    <i class="text-lg ph ph-lightning"></i>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>

          <!-- Enhanced Topic Display -->
          <% if conversation.conversation_topic.present? %>
            <div class="bg-base-200 px-6 py-4 border-2 border-base-300 rounded-2xl" data-test="conversation-topic">
              <div class="flex items-center gap-3">
                <div class="flex justify-center items-center bg-accent shadow-lg rounded-xl w-10 h-10 text-accent-content">
                  <i class="ph ph-chat-centered-text"></i>
                </div>
                <div>
                  <div class="font-bold text-sm text-base-content/70 uppercase tracking-wide">Discussion Topic</div>
                  <div class="font-bold text-base-content text-xl"><%= conversation.conversation_topic %></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Enhanced Actions -->
        <div class="flex items-center space-x-3">
          <%= link_to edit_conversation_path(conversation), 
              class: "btn btn-outline btn-neutral gap-2" do %>
            <i class="ph ph-pencil"></i>
            Edit
          <% end %>
          
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-circle btn-ghost">
              <i class="ph ph-dots-three-vertical"></i>
            </label>
            <ul tabindex="0" class="z-50 bg-base-100 shadow-2xl mt-2 p-3 border-2 border-base-300 rounded-2xl w-52 dropdown-content menu">
              <li>
                <%= button_to restart_conversation_path(conversation),
                    method: :post,
                    class: "btn btn-ghost btn-warning w-full justify-start gap-3",
                    data: { confirm: "Restart conversation? All messages will be deleted." } do %>
                  <i class="ph ph-arrow-counter-clockwise"></i>
                  Restart Chat
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Enhanced Status & Controls Bar -->
  <div id="conversation-controls-container"> <%# Target for broadcast_controls %>
    <div class="bg-neutral shadow-2xl mb-8 border-2 border-neutral-focus rounded-3xl overflow-hidden text-neutral-content"
        data-controller="streaming-conversation"
        data-streaming-conversation-conversation-id-value="<%= conversation.id %>"
        data-streaming-conversation-next-model-value="<%= conversation.next_speaker&.model_id %>">
      <!-- Status Bar Accent -->
      <div class="bg-gradient-to-r from-primary via-secondary to-accent h-1"></div>
      
      <div class="p-6 sm:p-8">
        <div class="flex lg:flex-row flex-col justify-between lg:items-center gap-6">
          
          <!-- Enhanced Progress Status -->
          <div class="flex items-center space-x-6">
            <!-- Round Progress Circle -->
            <div class="flex items-center space-x-4">
              <div class="relative">
                <% messages_count = conversation.messages.count %>
                <% if messages_count > 0 %>
                  <div class="flex justify-center items-center bg-primary shadow-2xl rounded-2xl w-16 h-16">
                    <span class="font-bold text-primary-content text-2xl">
                      <%= conversation.current_round %>
                    </span>
                  </div>
                  <!-- Animated Ring -->
                  <div class="absolute inset-0 bg-primary/30 rounded-2xl animate-ping"></div>
                <% else %>
                  <div class="flex justify-center items-center bg-base-300 shadow-2xl rounded-2xl w-16 h-16">
                    <i class="text-primary text-3xl ph ph-chat-circle"></i>
                  </div>
                <% end %>
              </div>
              <div>
                <div class="font-bold text-neutral-content text-xl" data-test="round-indicator">
                  <% if messages_count > 0 %>
                    Round <%= conversation.current_round %> / <%= conversation.max_rounds %>
                  <% else %>
                    Ready to Begin
                  <% end %>
                </div>
                <div class="font-medium text-neutral-content/70 text-sm">
                  <% if messages_count > 0 %>
                    <%= pluralize(messages_count, 'exchange', 'exchanges') %> complete
                  <% else %>
                    <%= pluralize(conversation.max_rounds, 'round', 'rounds') %> planned
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Enhanced Progress Bar -->
            <% if messages_count > 0 %>
              <div class="hidden lg:block w-48">
                <div class="flex justify-between mb-2 font-semibold text-neutral-content/70 text-sm">
                  <span>Round <%= conversation.current_round %></span>
                  <span>of <%= conversation.max_rounds %></span>
                </div>
                <div class="relative bg-neutral-focus shadow-inner rounded-full h-3 overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-r from-primary to-secondary rounded-full transition-all duration-500 ease-out" 
                       style="width: <%= (conversation.current_round.to_f / conversation.max_rounds * 100).round(1) %>%">
                  </div>
                  <div class="absolute inset-0 bg-gradient-to-r from-primary/30 to-secondary/30 rounded-full animate-pulse"></div>
                </div>
              </div>
            <% end %>

            <!-- Enhanced Next Speaker -->
            <% if conversation.next_speaker && conversation.ready_for_next_round? && !conversation.in_progress? %>
              <div class="flex items-center space-x-3 bg-success/20 shadow-lg px-4 py-3 border-2 border-success/30 rounded-2xl">
                <span class="font-bold text-success text-sm">Next Speaker:</span>
                <div class="w-10 h-10 rounded-xl <%= conversation.next_speaker.turn_order == 1 ? 'bg-primary' : 'bg-secondary' %> flex items-center justify-center text-primary-content shadow-lg">
                  <span class="text-lg">
                    <%= model_avatar_emoji(conversation.next_speaker.model_id) %>
                  </span>
                </div>
                <div>
                  <div class="font-bold text-neutral-content text-lg"><%= conversation.next_speaker.name %></div>
                  <div class="text-neutral-content/70 text-xs"><%= friendly_model_name(conversation.next_speaker.model_id) %></div>
                </div>
              </div>
            <% elsif conversation.in_progress? %>
              <div class="flex items-center space-x-3 bg-warning/20 shadow-lg px-4 py-3 border-2 border-warning/30 rounded-2xl">
                <div class="flex justify-center items-center bg-warning rounded-xl w-10 h-10 sm:w-8 sm:h-8 text-warning-content">
                  <div class="border-2 border-warning-content border-t-transparent rounded-full w-4 h-4 animate-spin"></div>
                </div>
                <span class="font-bold text-warning text-lg animate-pulse">AI is thinking...</span>
              </div>
            <% end %>
          </div>

          <!-- Enhanced Action Buttons -->
          <div class="flex items-center space-x-4">
            <% if conversation.ready_for_next_round? && !conversation.in_progress? %>
              <% if conversation.messages.empty? %>
                <!-- Enhanced Start Button -->
                <%= button_to start_conversation_path(conversation),
                    method: :post,
                    class: "btn btn-success btn-lg gap-3",
                    data: {
                      turbo_frame: "conversation",
                      streaming_conversation_target: "startButton",
                      controller: "conversation-controls",
                      action: "click->conversation-controls#showLoading",
                      test: "start-conversation-button"
                    } do %>
                  <i class="text-2xl ph ph-play"></i>
                  Start Dialogue
                <% end %>
              <% else %>
                <!-- Enhanced Continue Button -->
                <%= button_to continue_conversation_path(conversation), 
                    method: :post,
                    class: "btn btn-primary btn-lg gap-3",
                    data: { 
                      turbo_frame: "conversation",
                      streaming_conversation_target: "continueButton",
                      controller: "conversation-controls",
                      action: "click->conversation-controls#showLoading",
                      test: "continue-conversation-button"
                    } do %>
                  <i class="text-2xl ph ph-skip-forward"></i>
                  Next Round
                <% end %>
              <% end %>
            <% elsif !conversation.ready_for_next_round? && !conversation.in_progress? %>
              <!-- Enhanced Completed Status -->
              <div class="flex items-center gap-3 bg-success/20 shadow-lg px-6 py-4 border-2 border-success/30 rounded-2xl">
                <div class="flex justify-center items-center bg-success shadow-lg rounded-xl w-10 h-10 text-success-content">
                  <i class="text-lg ph ph-check-circle"></i>
                </div>
                <div>
                  <div class="font-bold text-success text-lg">Dialogue Complete</div>
                  <div class="text-neutral-content/70 text-sm">All rounds finished</div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error Alert -->
  <% if conversation_has_content_issues?(conversation) %>
    <div class="pt-4">
      <div class="alert alert-warning">
        <span class="material-symbols-outlined text-2xl">warning</span>
        <div>
          <div class="font-bold">Content Issues Detected</div>
          <div class="text-sm">
            <%= content_missing_count(conversation) %> message(s) have missing content. 
            <%= link_to "Debug", debug_conversation_path(conversation), class: "link link-hover", target: "_blank" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Messages -->
  <div class="py-6">
    <div id="conversation-messages" data-streaming-conversation-target="messagesContainer">
      <%= render partial: "conversations/messages", locals: { conversation: conversation } %>
    </div>
  </div>
  
</div>
