<div data-controller="conversation-updater" class="max-w-4xl mx-auto">
  
  <!-- Conversation Header Card -->
  <div class="bg-base-100 rounded-lg shadow-sm border border-base-300/40 mb-6">
    <div class="p-4 sm:p-6">
      <!-- Breadcrumb -->
      <div class="flex items-center text-sm text-base-content/80 mb-4">
        <%= link_to conversations_path, class: "hover:text-primary transition-colors" do %>
          Conversations
        <% end %>
        <span class="material-symbols-outlined text-lg mx-1">chevron_right</span>
        <span class="font-medium text-base-content">Current Chat</span>
      </div>

      <!-- Participants & Topic -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex-1">
          <!-- Participants -->
          <div class="flex items-center space-x-3 mb-2">
            <% conversation.participants.ordered.each_with_index do |p, i| %>
              <div class="flex items-center space-x-2">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br <%= i == 0 ? 'from-primary to-primary/80' : 'from-secondary to-secondary/80' %> flex items-center justify-center text-white font-semibold">
                  <%= model_avatar_emoji(p.model_id) %>
                </div>
                <span class="font-medium text-base-content"><%= p.name || "AI #{i + 1}" %></span>
              </div>
              <% if i < conversation.participants.count - 1 %>
                <div class="hidden sm:flex items-center">
                  <span class="material-symbols-outlined text-base-content/40">bolt</span>
                </div>
              <% end %>
            <% end %>
          </div>

          <!-- Topic -->
          <% if conversation.conversation_topic.present? %>
            <p class="text-sm text-base-content/70" data-test="conversation-topic">
              <span class="font-medium">Topic:</span> <%= conversation.conversation_topic %>
            </p>
          <% end %>
        </div>

        <!-- Actions -->
        <div class="flex items-center space-x-2">
          <%= link_to edit_conversation_path(conversation), 
              class: "btn btn-ghost btn-sm gap-2" do %>
            <span class="material-symbols-outlined text-lg">edit</span>
            Edit
          <% end %>
          
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-sm btn-circle">
              <span class="material-symbols-outlined">more_vert</span>
            </label>
            <ul tabindex="0" class="dropdown-content z-50 menu p-2 shadow-lg bg-base-100 rounded-box w-48 border border-base-200/50">
              <li>
                <%= button_to restart_conversation_path(conversation),
                    method: :post,
                    class: "text-warning w-full text-left flex items-center gap-2",
                    data: { confirm: "Restart conversation? All messages will be deleted." } do %>
                  <span class="material-symbols-outlined">replay</span>
                  Restart Chat
                <% end %>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Unified Status & Controls Bar -->
  <div id="conversation-controls-container"> <%# Target for broadcast_controls %>
    <div class="bg-neutral text-neutral-content rounded-lg shadow-lg border border-base-300/40 mb-6"
        data-controller="streaming-conversation"
        data-streaming-conversation-conversation-id-value="<%= conversation.id %>"
        data-streaming-conversation-next-model-value="<%= conversation.next_speaker&.model_id %>">
      <div class="p-4 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          
          <!-- Left: Progress Status -->
          <div class="flex items-center space-x-4">
            <!-- Round Progress -->
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center ring-2 ring-primary/50">
                <span class="text-lg font-semibold text-primary">
                  <%= [conversation.current_round, 1].max %>
                </span>
              </div>
              <div>
                <div class="text-md font-semibold text-neutral-content" data-test="round-indicator">
                  Round <%= [conversation.current_round, 1].max %> / <%= conversation.max_rounds %>
                </div>
                <div class="text-xs text-neutral-content/70">
                  <% assistant_messages_count = conversation.messages.where(role: 'assistant').count %>
                  <% if assistant_messages_count > 0 %>
                    <%= pluralize(assistant_messages_count, 'message') %> exchanged
                  <% else %>
                    Ready to start
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Progress Bar -->
            <% if conversation.messages.any? %>
              <div class="hidden sm:block w-32">
                <div class="flex justify-between text-xs text-neutral-content/70 mb-1">
                  <span><%= [conversation.current_round, 1].max %></span>
                  <span><%= conversation.max_rounds %></span>
                </div>
                <progress class="progress progress-primary w-full h-2.5" 
                          value="<%= [conversation.current_round, 1].max %>" 
                          max="<%= conversation.max_rounds %>"></progress>
              </div>
            <% end %>

            <!-- Next Speaker -->
            <% if conversation.next_speaker && conversation.can_continue? && !conversation.generating? %>
              <div class="flex items-center space-x-2 px-3 py-2 bg-neutral-focus rounded-lg shadow">
                <span class="text-xs text-neutral-content/70">Next:</span>
                <div class="w-6 h-6 rounded-full bg-<%= conversation.next_speaker.turn_order == 1 ? 'primary' : 'secondary' %> flex items-center justify-center ring-1 ring-offset-1 ring-offset-neutral-focus ring-<%= conversation.next_speaker.turn_order == 1 ? 'primary' : 'secondary' %>-focus">
                  <span class="text-sm text-white">
                    <%= model_avatar_emoji(conversation.next_speaker.model_id) %>
                  </span>
                </div>
                <span class="text-sm font-semibold text-neutral-content"><%= conversation.next_speaker.name %></span>
              </div>
            <% elsif conversation.generating? %>
              <div class="flex items-center space-x-2 px-3 py-2 bg-neutral-focus rounded-lg shadow">
                <span class="loading loading-spinner loading-xs text-info"></span>
                <span class="text-xs text-info animate-pulse">Generating response...</span>
              </div>
            <% end %>
          </div>

          <!-- Right: Status & Actions -->
          <div class="flex items-center space-x-3">
            <% if conversation.can_continue? && !conversation.generating? %>
              <!-- Auto-continue Toggle -->
              <div class="flex items-center space-x-2" title="Toggle Auto-Continue">
                <label class="label cursor-pointer gap-2 py-0">
                  <span class="material-symbols-outlined text-neutral-content/80 text-xl">autoplay</span>
                  <input type="checkbox"
                        class="toggle toggle-primary toggle-sm"
                        data-controller="auto-continue"
                        data-action="change->auto-continue#toggle"
                        data-auto-continue-conversation-id-value="<%= conversation.id %>"
                        data-auto-continue-max-rounds-value="<%= conversation.max_rounds %>"
                        data-auto-continue-active-value="false"
                        data-test="auto-continue-toggle" />
                </label>
              </div>

              <% if conversation.messages.where(role: "assistant").empty? %>
                <!-- Start Button -->
                <%= button_to start_conversation_path(conversation),
                    method: :post,
                    class: "btn btn-primary btn-sm gap-2 shadow hover:shadow-lg",
                    data: {
                      turbo_frame: "conversation", # This might need to be the broader frame if controls are outside
                      streaming_conversation_target: "startButton",
                      controller: "conversation-controls",
                      action: "click->conversation-controls#showLoading",
                      test: "start-conversation-button"
                    } do %>
                  <span class="material-symbols-outlined">play_arrow</span>
                  Start
                <% end %>
              <% else %>
                <!-- Continue Button -->
                <%= button_to continue_conversation_path(conversation), 
                    method: :post,
                    class: "btn btn-primary btn-sm gap-2 shadow hover:shadow-lg",
                    data: { 
                      turbo_frame: "conversation", # This might need to be the broader frame
                      streaming_conversation_target: "continueButton",
                      controller: "conversation-controls",
                      action: "click->conversation-controls#showLoading",
                      test: "continue-conversation-button"
                    } do %>
                  <span class="material-symbols-outlined">fast_forward</span>
                  <span class="auto-continue-button-text">Next Round</span>
                <% end %>
              <% end %>
            <% elsif !conversation.can_continue? && !conversation.generating? %>
              <!-- Completed Status -->
              <div class="badge badge-success gap-2 p-4 shadow">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="font-medium">Completed</span>
              </div>
            <% end %>
            <!-- Note: While generating, no buttons are shown, only the spinner in the left section -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Error Alert -->
  <% if conversation_has_content_issues?(conversation) %>
    <div class="pt-4">
      <div class="alert alert-warning">
        <span class="material-symbols-outlined text-2xl">warning</span>
        <div>
          <div class="font-bold">Content Issues Detected</div>
          <div class="text-sm">
            <%= content_missing_count(conversation) %> message(s) have missing content. 
            <%= link_to "Debug", debug_conversation_path(conversation), class: "link link-hover", target: "_blank" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Messages -->
  <div class="py-6">
    <div id="conversation-messages" data-streaming-conversation-target="messagesContainer">
      <%= render partial: "conversations/messages", locals: { conversation: conversation } %>
    </div>
  </div>
  
</div>
